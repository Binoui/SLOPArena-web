# Astro fingerprints all generated assets, including optimized images.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Unfingerprinted images copied from public/.
/social-preview.png
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/devlog/*.webp
  Cache-Control: public, max-age=604800
