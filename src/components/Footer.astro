---
import { links } from '../config'
import { href } from '../lib/paths'
import { ui } from '../data/ui'


const t = ui
const columns = [
  {
    title: t.footer.play,
    links: [
      { label: t.nav.what, href: href('docs/what-is-sloparena/') },
      { label: 'Steam', href: links.steam, external: true },
      { label: t.nav.play, href: href('play/') },
      { label: t.nav.fighters, href: href('fighters/') },
      { label: t.nav.feedback, href: href('feedback/') },
    ],
  },
  {
    title: t.footer.community,
    links: [
      { label: 'Discord', href: links.discord, external: true },
      { label: 'Reddit', href: links.reddit, external: true },
      { label: 'YouTube', href: links.youtube, external: true },
      { label: 'X', href: links.x, external: true },
      { label: 'TikTok', href: links.tiktok, external: true },
    ],
  },
  {
    title: t.footer.build,
    links: [
      { label: t.nav.who, href: href('docs/who-made-this/') },
      { label: t.nav.docs, href: href('docs/') },
      { label: t.footer.gameSource, href: links.github, external: true },
      { label: t.footer.siteSource, href: links.webRepo, external: true },
    ],
  },
]
---
<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div class="site-footer__brand">
      <a class="brand" href={href()} aria-label={t.home}>SLOPArena</a>
      <p class="site-footer__tagline">{t.footer.tagline}</p>
    </div>
    {columns.map((column) => (
      <nav aria-label={column.title}>
        <h2>{column.title}</h2>
        <ul>
          {column.links.map((link) => (
            <li>
              {link.external
                ? <a href={link.href} target="_blank" rel="noopener">{link.label} <span aria-hidden="true">↗</span><span class="sr-only">{t.common.newTab}</span></a>
                : <a href={link.href}>{link.label}</a>}
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>
  <div class="wrap site-footer__bottom">
    <span>{t.footer.status}</span>
    <a href={links.github} target="_blank" rel="noopener">{t.footer.license} <span aria-hidden="true">↗</span><span class="sr-only">{t.common.newTab}</span></a>
  </div>
</footer>
