---
import Base from '../layouts/Base.astro'
import { href } from '../lib/paths'
---
<Base route="" title="Page not found" description="This page flew past the blast zone." noindex>
  <section class="section">
    <div class="wrap not-found">
      <p class="sticker">404 · Ring out</p>
      <h1>Off the stage.</h1>
      <p class="lede">This page flew past the blast zone.</p>
      <div class="callout__actions">
        <a class="btn btn--yellow" href={href()}>Back to the arena</a>
      </div>
    </div>
  </section>
</Base>
