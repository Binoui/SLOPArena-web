---
import { render } from 'astro:content'
import Base from '../layouts/Base.astro'
import { getDocs, type Doc } from '../lib/docs'
import { formatDate } from '../lib/format'
import { links } from '../config'
import { href } from '../lib/paths'

interface Props {
  doc: Doc
}

const { doc } = Astro.props

const copy = {
    docs: 'Docs',
    nav: 'Documentation',
    breadcrumb: 'Breadcrumb',
    sections: { about: 'About', play: 'Playing', build: 'Behind the slop' },
    play: 'How to play',
    updated: 'Updated',
    edit: 'Edit this page on GitHub',
    previous: 'Previous',
    next: 'Next',
    zoom: 'Enlarge image',
    close: 'Close',
  }

const { Content } = await render(doc.entry)
const docs = await getDocs()
const index = docs.findIndex((item) => item.slug === doc.slug)
const previous = docs[index - 1]
const next = docs[index + 1]
const route = `docs/${doc.slug}/`
const editUrl = `${links.webRepo}/edit/main/${doc.entry.filePath}`
---
<Base route={route} title={doc.entry.data.title} description={doc.entry.data.description}>
  <section class="page-hero">
    <div class="wrap">
      <nav class="breadcrumb label" aria-label={copy.breadcrumb}><a href={href('docs/')}>{copy.docs}</a> / {copy.sections[doc.entry.data.section]}</nav>
      <h1>{doc.entry.data.title}</h1>
      <p class="lede">{doc.entry.data.description}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap docs-layout">
      <nav class="docs-nav" aria-label={copy.nav}>
        {(['about', 'play', 'build'] as const).map((section) => {
          const items = docs.filter((item) => item.entry.data.section === section)
          return (items.length > 0 || section === 'play') && (
            <>
              <h2>{copy.sections[section]}</h2>
              <ul>
                {section === 'play' && <li><a href={href('play/')}>{copy.play}</a></li>}
                {items.map((item) => (
                  <li><a href={href(`docs/${item.slug}/`)} aria-current={item.slug === doc.slug ? 'page' : undefined}>{item.entry.data.title}</a></li>
                ))}
              </ul>
            </>
          )
        })}
      </nav>
      <div>
        <article class="prose" data-zoom-label={copy.zoom}>
          <Content />
        </article>
        <div class="doc-meta label">
          <span>{copy.updated} {formatDate(doc.entry.data.updated)}</span>
          <a href={editUrl} target="_blank" rel="noopener">{copy.edit} ↗</a>
        </div>
        {(previous || next) && (
          <nav class="doc-pager" aria-label={`${copy.previous} / ${copy.next}`}>
            {previous && <a href={href(`docs/${previous.slug}/`)}><span class="label">← {copy.previous}</span><b>{previous.entry.data.title}</b></a>}
            {next && <a class="next" href={href(`docs/${next.slug}/`)}><span class="label">{copy.next} →</span><b>{next.entry.data.title}</b></a>}
          </nav>
        )}
      </div>
    </div>
  </section>

  <dialog class="lightbox" aria-label={copy.zoom}>
    <button class="lightbox-close" type="button" aria-label={copy.close}>×</button>
    <img alt="" />
  </dialog>
</Base>

<script>
  const prose = document.querySelector<HTMLElement>('.prose[data-zoom-label]')
  const dialog = document.querySelector<HTMLDialogElement>('dialog.lightbox')
  const full = dialog?.querySelector('img')

  if (prose && dialog && full) {
    // Linked images keep their link; everything else in a figure can be enlarged.
    const images = [...prose.querySelectorAll<HTMLImageElement>('figure img')].filter((img) => !img.closest('a'))

    const open = (img: HTMLImageElement) => {
      full.src = img.currentSrc || img.src
      full.alt = img.alt
      dialog.showModal()
    }

    for (const img of images) {
      img.classList.add('zoomable')
      img.tabIndex = 0
      img.setAttribute('role', 'button')
      img.setAttribute('aria-label', `${prose.dataset.zoomLabel}: ${img.alt}`)
      img.addEventListener('click', () => open(img))
      img.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return
        event.preventDefault()
        open(img)
      })
    }

    // Any click inside the modal closes it, image included; Escape is handled by <dialog>.
    dialog.addEventListener('click', () => dialog.close())
  }
</script>
