---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Icon from '../components/Icon.astro'
import { fighters, jumpHeight, kits, tuningSnapshot, type Fighter, type Kit } from '../data/fighters'
import { links } from '../config'
import { formatDate, formatNumber } from '../lib/format'
import { href } from '../lib/paths'
import { ui } from '../data/ui'

interface Props {
  fighter: Fighter
}

const { fighter } = Astro.props
const t = ui

const copy = {
    description: (name: string, epithet: string) => `${name}, ${epithet.toLowerCase()}: SLOPArena fighter brief with specials, normals, strengths and weaknesses.`,
    crumbs: 'Fighters',
    breadcrumb: 'Breadcrumb',
    portrait: 'Character art',
    steam: 'Play on Steam',
    report: (name: string) => `Main ${name}? Report what’s broken`,
    plan: 'Game plan',
    good: 'Good at',
    bad: 'Bad at',
    specials: 'Specials',
    specialsLede: 'Cooldowns start when the move ends. Every E special is a recovery move.',
    normals: 'Normals',
    normalsLede: 'No cooldowns. The same key does something different on the ground and in the air.',
    movement: 'Movement',
    stats: ['Run speed', 'Air speed', 'Jump height', 'Gravity'],
    tuning: (date: string) => `Playtest tuning as of ${date}. Jump height is estimated from jump speed and gravity. Numbers move between builds.`,
    inGame: 'In game',
    others: 'The rest of the roster',
    form: 'Second form',
    formLede: 'F swaps forms. Each form has its own normals, specials and movement.',
  }

const n = (value: number) => formatNumber(value)
const max = (pick: (kit: Kit) => number) => Math.max(...kits.map(pick))
const stats = ({ movement }: Kit) => [
  { label: copy.stats[0], value: movement.run, max: max((k) => k.movement.run), text: `${n(movement.run)} m/s` },
  { label: copy.stats[1], value: movement.air, max: max((k) => k.movement.air), text: `${n(movement.air)} m/s` },
  { label: copy.stats[2], value: jumpHeight(movement), max: max((k) => jumpHeight(k.movement)), text: `≈${n(jumpHeight(movement))} m` },
  { label: copy.stats[3], value: movement.gravity, max: max((k) => k.movement.gravity), text: `${n(movement.gravity)} m/s²` },
]
const alternate = fighter.alternateForm
const forms: { name: string; kit: Kit }[] = [{ name: fighter.name, kit: fighter }, ...(alternate ? [{ name: alternate.name, kit: alternate }] : [])]
const titled = (title: string, name: string) => (forms.length > 1 ? `${title} · ${name}` : title)
const route = `fighters/${fighter.id}/`
---
<Base route={route} title={fighter.name} description={copy.description(fighter.name, fighter.epithet)}>
  <div class="fighter-page" style={`--accent: ${fighter.accent}`}>
    <section class="fighter-hero">
      <div class="wrap fighter-hero__grid">
        <figure class="portrait-card">
          <Image src={fighter.portrait} alt={fighter.name} widths={[400, 512]} sizes="(max-width: 900px) 90vw, 480px" loading="eager" fetchpriority="high" />
          <figcaption>{copy.portrait}</figcaption>
        </figure>
        <div>
          <nav class="breadcrumb label" aria-label={copy.breadcrumb}><a href={href('fighters/')}>{copy.crumbs}</a> / {fighter.name}</nav>
          <h1 style={`--chars: ${fighter.name.length}`}>{fighter.name}</h1>
          <p class="strip">{fighter.epithet}</p>
          {fighter.wip && <p class="sticker fighter-hero__wip" title={t.common.wipTitle}>{t.common.wip}</p>}
          <p class="fighter-hero__pitch">{fighter.pitch}</p>
          <ul class="tags">{fighter.tags.map((tag) => <li class="tag">{tag}</li>)}</ul>
          <div class="fighter-hero__actions">
            <a class="btn btn--yellow" href={links.steam} target="_blank" rel="noopener"><Icon name="steam" />{copy.steam} ↗</a>
            <a class="text-link" href={`${href('feedback/')}?fighter=${fighter.id}`}>{copy.report(fighter.name)} →</a>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap split">
        <div>
          <h2 class="h3-title">{copy.plan}</h2>
          <ol class="gameplan">{fighter.gameplan.map((step) => <li>{step}</li>)}</ol>
        </div>
        <div class="verdicts">
          <div class="verdict verdict--good">
            <h3>{copy.good}</h3>
            <ul>{fighter.strengths.map((item) => <li>{item}</li>)}</ul>
          </div>
          <div class="verdict verdict--bad">
            <h3>{copy.bad}</h3>
            <ul>{fighter.weaknesses.map((item) => <li>{item}</li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    {forms.map(({ name, kit }, formIndex) => (
      <Fragment>
        {formIndex > 0 && alternate && (
          <section class="section">
            <div class="wrap form-intro">
              <Image src={alternate.portrait} alt={alternate.name} widths={[240, 320]} sizes="160px" />
              <div>
                <p class="kicker">{copy.form}</p>
                <h2>{alternate.name}</h2>
                <p class="lede">{alternate.pitch}</p>
                <p class="fine-print">{copy.formLede}</p>
              </div>
            </div>
          </section>
        )}

        <section class="section">
          <div class="wrap">
            <h2 class="h3-title">{titled(copy.specials, name)}</h2>
            <p class="section-lede">{copy.specialsLede}</p>
            <ul class="specials">
              {kit.specials.map((special) => {
                const signature = formIndex === 0 && special.slot === fighter.signature
                return (
                  <li class:list={['special', signature && 'special--signature']}>
                    <span class="key key--ink">{t.specialKeys[special.slot]}</span>
                    <div>
                      <h3>{special.name}</h3>
                      <p class="special__meta">
                        <span class="flag">{t.slots[special.slot]}</span>
                        <span>{special.limit ? special.limit : `${n(special.cooldownSeconds)} s ${t.common.cooldown}`}</span>
                        {signature && <span class="flag flag--accent">{t.common.mustTry}</span>}
                      </p>
                    </div>
                    <p>{special.text}</p>
                  </li>
                )
              })}
            </ul>
          </div>
        </section>

        <section class="section">
          <div class="wrap">
            <h2 class="h3-title">{titled(copy.normals, name)}</h2>
            <p class="section-lede">{copy.normalsLede}</p>
            <div class="normals">
              {(['ground', 'air'] as const).map((place) => (
                <table>
                  <caption>{place === 'ground' ? t.common.ground : t.common.air}</caption>
                  <tbody>
                    {kit.normals[place].map((move, index) => (
                      <tr><th scope="row"><span class="key">{index + 1}</span></th><td>{move}</td></tr>
                    ))}
                  </tbody>
                </table>
              ))}
            </div>
          </div>
        </section>
      </Fragment>
    ))}

    <section class="section">
      <div class="wrap split">
        <div>
          <h2 class="h3-title">{copy.movement}</h2>
          {forms.map(({ name, kit }) => (
            <Fragment>
              {forms.length > 1 && <h3 class="stats__form">{name}</h3>}
              <ul class="stats">
                {stats(kit).map((stat) => (
                  <li class="stat">
                    <span>{stat.label}</span>
                    <span class="stat__bar" aria-hidden="true"><span style={`width: ${Math.round((stat.value / stat.max) * 100)}%`}></span></span>
                    <span class="stat__value">{stat.text}</span>
                  </li>
                ))}
              </ul>
            </Fragment>
          ))}
          <p class="fine-print">{copy.tuning(formatDate(new Date(tuningSnapshot)))}</p>
        </div>
        <div>
          <h2 class="h3-title">{copy.inGame}</h2>
          <figure class="shot-frame">
            <Image src={fighter.shot} alt={fighter.shotAlt} widths={[640, 960, 1280]} sizes="(max-width: 900px) 92vw, 560px" />
          </figure>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <h2 class="h3-title">{copy.others}</h2>
        <ul class="roster-nav">
          {fighters.map((other) => (
            <li>
              <a href={href(`fighters/${other.id}/`)} aria-current={other.id === fighter.id ? 'page' : undefined}>
                <Image src={other.portrait} alt="" widths={[112]} sizes="56px" />
                <span>{other.name}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  </div>
</Base>
