---
import Base from '../layouts/Base.astro'
import FighterCard from '../components/FighterCard.astro'
import { fighters, jumpHeight } from '../data/fighters'
import { formatNumber } from '../lib/format'
import { href } from '../lib/paths'



const copy = {
    title: 'Fighters',
    description: 'Meet the SLOPArena roster: FightGuy, Manki, Wibou, Sir Bonk, Bashie, Salamander and Nyx. Kits, specials, strengths and weaknesses.',
    kicker: 'The roster',
    lede: 'Seven kits, one control scheme. Every fighter has three normals on 1–3 (different on the ground and in the air) and four specials on Q, E, R and F, each with its own cooldown. E is always the move that gets you back on stage. Fighters with a WIP sticker are still being built.',
    compare: 'Side by side',
    columns: ['Fighter', 'Style', 'Recovery (E)', 'Run', 'Air', 'Jump'],
    note: 'Movement from the playtest tuning. Jump height is estimated from jump speed and gravity.',
  }

const n = (value: number) => formatNumber(value)
---
<Base route="fighters/" title={copy.title} description={copy.description}>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">{copy.kicker}</p>
      <h1>{copy.title}</h1>
      <p class="lede">{copy.lede}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <ul class="roster">
        {fighters.map((fighter) => <li><FighterCard fighter={fighter} heading="h2" /></li>)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="h3-title">{copy.compare}</h2>
      <div class="table-scroll">
        <table class="data-table">
          <thead>
            <tr>{copy.columns.map((column) => <th scope="col">{column}</th>)}</tr>
          </thead>
          <tbody>
            {fighters.map((fighter) => (
              <tr>
                <th scope="row"><a href={href(`fighters/${fighter.id}/`)}>{fighter.name}</a></th>
                <td>{fighter.tags.join(' · ')}</td>
                <td>{fighter.specials.find((special) => special.slot === 'E')!.name}</td>
                <td>{n(fighter.movement.run)} m/s</td>
                <td>{n(fighter.movement.air)} m/s</td>
                <td>≈{n(jumpHeight(fighter.movement))} m</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="fine-print">{copy.note}</p>
    </div>
  </section>
</Base>
