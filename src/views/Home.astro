---
import { Image } from 'astro:assets'
import Base from '../layouts/Base.astro'
import Presence from '../components/Presence.astro'
import Icon from '../components/Icon.astro'
import { fighters } from '../data/fighters'
import { getDocs } from '../lib/docs'
import { formatDay } from '../lib/format'
import { links, steamAppId, trailer } from '../config'
import { href, type Lang } from '../i18n'
import { ui } from '../i18n/ui'
import heroShot from '../assets/screens/manki-bazooka-rooftop.jpg'
import nameplate from '../assets/key-art/nameplate.png'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = ui[lang]
const wip = fighters.filter((fighter) => fighter.wip).map((fighter) => fighter.name)
const and = { en: 'and', fr: 'et' }[lang]
const wipNames = wip.length > 1 ? `${wip.slice(0, -1).join(', ')} ${and} ${wip.at(-1)}` : wip.join('')

const copy = {
  en: {
    title: 'SLOPArena · a free, open-source fighting game',
    description: 'A free, open-source 3D fighting game made by one person with AI, in public. No shop, no battle pass. The code, the tools and the notes are on GitHub.',
    hi: 'Hi, I’m Binoui.',
    letter: [
      'SLOPArena is the fighting game I’ve always wanted to play. I’ve been making it since May with a lot of help from AI, and I’m doing it in public.',
      'It’s free, and it stays free. There’s no shop, nothing to unlock with money, no battle pass. The code, the tools and the notes on every mistake are open source on GitHub.',
      'I want it to belong to the people who play it. You can make your own fighter, or just tell me what felt bad and watch it change. Later on, you’ll be able to run your own servers too.',
    ],
    steam: 'Get it free on Steam',
    demo: 'Play in your browser',
    code: 'Read the code',
    access: 'It’s a playtest, so Steam access is by request. Steam emails you when you’re in.',
    launch: 'Already in? Launch it',
    shotAlt: 'Manki’s bazooka sends FightGuy flying on a neon rooftop',
    shotCaption: 'Manki’s bazooka sends FightGuy off a rooftop. That’s a real match, not a render.',
    trailer: 'Watch the trailer',
    facts: [
      ['€0', 'to play, nothing to buy'],
      ['MIT', 'license'],
      ['26 May 2026', 'first commit, all public'],
      [String(fighters.length), 'fighters, up to 4 players'],
    ],
    tryTitle: 'Try it without installing anything',
    browserTitle: 'In your browser',
    browserText: 'The same fighters and moves, in a tab. It’s rougher than the Steam build.',
    browserCta: 'Open the demo',
    terminalTitle: 'In your terminal',
    terminalText: 'Two CPU fighters brawl right in your terminal. That’s the real game simulation, with no graphics attached. You need Git and .NET 8.',
    postsTitle: 'What I’ve been working on',
    allPosts: 'Everything I’ve written',
    commits: 'Every commit on GitHub',
    helpTitle: 'Want to help?',
    help: [
      `<strong>Play it with friends</strong> and tell me what broke on the <a href="${href(lang, 'feedback/')}">feedback form</a>. One sentence is plenty. I read all of them.`,
      `<strong>Make a fighter.</strong> SlopBot walks your AI assistant through it, from the idea to a playable kit. Nobody has finished one yet, so you’d be the first. <a href="${href(lang, 'docs/contribute/')}">Start here</a>.`,
      `<strong>Design a stage.</strong> Pitch it, block it out with an AI helper, then dress it. Most of the current stages went through <a href="https://github.com/Binoui/SLOPArena/blob/main/docs/design/stage-concepts.md" target="_blank" rel="noopener">this process</a>.`,
      `<strong>Poke at the code.</strong> It’s MIT-licensed. Point your agent at <code>AGENTS.md</code>, they love it in there.`,
      `<strong>Come say hi</strong> on <a href="${links.discord}" target="_blank" rel="noopener">Discord</a>. It’s also where people find matches.`,
    ],
    fightersTitle: 'The fighters so far',
    fightersText: `${fighters.length} of them. ${wipNames} are still missing bits.`,
    fightersLink: 'See what each one does',
    rosterLabel: 'The fighters',
  },
  fr: {
    title: 'SLOPArena · un jeu de combat gratuit et open source',
    description: 'Un jeu de combat 3D gratuit et open source, fait par une seule personne avec l’IA, en public. Pas de boutique, pas de passe de combat. Le code, les outils et les notes sont sur GitHub.',
    hi: 'Salut, moi c’est Binoui.',
    letter: [
      'SLOPArena, c’est le jeu de combat auquel j’ai toujours voulu jouer. Je le fais depuis mai avec beaucoup d’aide de l’IA, et je le fais en public.',
      'Il est gratuit et il le restera. Pas de boutique, rien à débloquer en payant, pas de passe de combat. Le code, les outils et les notes sur chaque erreur sont open source sur GitHub.',
      'Je veux qu’il appartienne à ceux qui y jouent. Vous pouvez créer votre propre combattant, ou juste me dire ce qui ne va pas et le voir changer. Plus tard, vous pourrez aussi héberger vos propres serveurs.',
    ],
    steam: 'Gratuit sur Steam',
    demo: 'Jouer dans le navigateur',
    code: 'Lire le code',
    access: 'C’est un playtest, donc l’accès Steam se fait sur demande. Steam vous écrit quand vous êtes dedans.',
    launch: 'Déjà dedans ? Lancer le jeu',
    shotAlt: 'Le bazooka de Manki envoie FightGuy valser sur un toit sous les néons',
    shotCaption: 'Le bazooka de Manki envoie FightGuy du haut d’un toit. C’est un vrai match, pas un rendu.',
    trailer: 'Voir la bande-annonce',
    facts: [
      ['0 €', 'pour jouer, rien à acheter'],
      ['MIT', 'licence'],
      ['26 mai 2026', 'premier commit, tout est public'],
      [String(fighters.length), 'combattants, jusqu’à 4 joueurs'],
    ],
    tryTitle: 'Essayer sans rien installer',
    browserTitle: 'Dans le navigateur',
    browserText: 'Les mêmes combattants et les mêmes coups, dans un onglet. C’est moins abouti que la version Steam.',
    browserCta: 'Ouvrir la démo',
    terminalTitle: 'Dans le terminal',
    terminalText: 'Deux combattants contrôlés par l’ordinateur se battent dans votre terminal. C’est la vraie simulation du jeu, sans graphismes. Il faut Git et .NET 8.',
    postsTitle: 'Ce sur quoi je travaille',
    allPosts: 'Tout ce que j’ai écrit',
    commits: 'Tous les commits sur GitHub',
    helpTitle: 'Envie d’aider ?',
    help: [
      `<strong>Jouez entre amis</strong> et dites-moi ce qui a cassé avec le <a href="${href(lang, 'feedback/')}">formulaire d’avis</a>. Une phrase suffit. Je les lis toutes.`,
      `<strong>Créez un combattant.</strong> SlopBot guide votre assistant IA de l’idée jusqu’à un kit jouable. Personne n’en a encore terminé un, vous seriez la première personne à le faire. <a href="${href(lang, 'docs/contribute/')}">Par ici</a>.`,
      `<strong>Imaginez une arène.</strong> Proposez-la, maquettez-la avec un assistant IA, puis habillez-la. La plupart des arènes actuelles sont passées par <a href="https://github.com/Binoui/SLOPArena/blob/main/docs/design/stage-concepts.md" target="_blank" rel="noopener">ce processus</a>.`,
      `<strong>Fouillez le code.</strong> Il est sous licence MIT. Donnez <code>AGENTS.md</code> à votre agent, il va adorer.`,
      `<strong>Passez dire bonjour</strong> sur <a href="${links.discord}" target="_blank" rel="noopener">Discord</a>. C’est aussi là qu’on trouve des adversaires.`,
    ],
    fightersTitle: 'Les combattants',
    fightersText: `${fighters.length} pour l’instant. Il manque encore des morceaux à ${wipNames}.`,
    fightersLink: 'Voir ce que chacun sait faire',
    rosterLabel: 'Les combattants',
  },
}[lang]

const posts = (await getDocs(lang))
  .filter((doc) => doc.entry.data.section === 'build' && doc.slug !== 'contribute')
  .sort((a, b) => b.entry.data.updated.getTime() - a.entry.data.updated.getTime())
  .slice(0, 3)
const spectate = `git clone https://github.com/Binoui/SLOPArena.git
cd SLOPArena
dotnet run --project tools/SpectateView \\
  -p:SkipUnityPluginCopy=true -- --char manki`
const siteUrl = Astro.site?.href
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      name: 'SLOPArena',
      alternateName: ['Slop Arena', 'SLOPA'],
      url: siteUrl,
      inLanguage: lang,
    },
    {
      '@type': 'VideoGame',
      '@id': `${siteUrl}#game`,
      name: 'SLOPArena',
      alternateName: ['Slop Arena'],
      description: copy.description,
      url: siteUrl,
      image: new URL('/social-preview.png?v=4', Astro.site).href,
      genre: ['Platform fighter', 'Fighting'],
      gamePlatform: 'Windows',
      playMode: ['MultiPlayer', 'SinglePlayer'],
      author: { '@type': 'Person', name: 'Binoui' },
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
      sameAs: [`https://store.steampowered.com/app/${steamAppId}/`, links.github, links.x, links.youtube],
    },
  ],
}
---
<Base lang={lang} route="" title={copy.title} description={copy.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <section class="home-hero">
    <div class="wrap home-hero__grid">
      <div class="letter">
        <h1>
          <span class="sr-only">SLOPArena</span>
          <Image class="letter__plate" src={nameplate} alt="" aria-hidden="true" widths={[400, 800]} sizes="360px" loading="eager" />
        </h1>
        <p class="letter__hi">{copy.hi}</p>
        {copy.letter.map((paragraph) => <p>{paragraph}</p>)}
        <div class="letter__actions">
          <a class="btn btn--yellow" href={links.steam} target="_blank" rel="noopener" aria-label={t.steam.ctaAria}><Icon name="steam" />{copy.steam}</a>
          <a class="btn" href={links.demo}>{copy.demo}</a>
          <a class="btn btn--ink" href={links.github} target="_blank" rel="noopener"><Icon name="github" />{copy.code}</a>
        </div>
        <p class="letter__small">{copy.access} <a href={links.steamLaunch}>{copy.launch}</a></p>
      </div>
      <figure class="home-shot">
        <Image src={heroShot} alt={copy.shotAlt} widths={[640, 960, 1280]} sizes="(max-width: 860px) 92vw, 560px" loading="eager" fetchpriority="high" />
        <figcaption>{copy.shotCaption} <a href={`https://www.youtube.com/watch?v=${trailer.youtubeId}`} target="_blank" rel="noopener">{copy.trailer} ↗</a></figcaption>
      </figure>
    </div>
    <ul class="wrap facts">
      {copy.facts.map(([value, label]) => <li><strong>{value}</strong> {label}</li>)}
    </ul>
  </section>

  <Presence lang={lang} />

  <section class="home-section">
    <div class="wrap">
      <h2>{copy.tryTitle}</h2>
      <div class="try">
        <div>
          <h3>{copy.browserTitle}</h3>
          <p>{copy.browserText}</p>
          <a class="btn" href={links.demo}>{copy.browserCta}</a>
        </div>
        <div>
          <h3>{copy.terminalTitle}</h3>
          <p>{copy.terminalText}</p>
          <pre><code>{spectate}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="wrap home-cols">
      <div>
        <h2>{copy.postsTitle}</h2>
        <ul class="posts">
          {posts.map((post) => (
            <li>
              <a href={href(lang, `docs/${post.slug}/`)}>
                <time datetime={post.entry.data.updated.toISOString().slice(0, 10)}>{formatDay(lang, post.entry.data.updated)}</time>
                <span class="posts__title">{post.entry.data.title}</span>
                <span class="posts__text">{post.entry.data.description}</span>
              </a>
            </li>
          ))}
        </ul>
        <p><a href={href(lang, 'docs/')}>{copy.allPosts}</a> · <a href={`${links.github}/commits/main/`} target="_blank" rel="noopener">{copy.commits} ↗</a></p>
      </div>
      <div>
        <h2>{copy.helpTitle}</h2>
        <ul class="help">
          {copy.help.map((item) => <li set:html={item} />)}
        </ul>
      </div>
    </div>
  </section>

  <section class="home-section">
    <div class="wrap">
      <h2>{copy.fightersTitle}</h2>
      <p>{copy.fightersText} <a href={href(lang, 'fighters/')}>{copy.fightersLink}</a>.</p>
      <ul class="home-roster" aria-label={copy.rosterLabel}>
        {fighters.map((fighter) => (
          <li style={`--accent: ${fighter.accent}`}>
            <a class="mini-card" href={href(lang, `fighters/${fighter.id}/`)}>
              <Image src={fighter.portrait} alt="" widths={[256]} sizes="120px" />
              <span style={`--chars: ${fighter.name.length}`}>{fighter.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
