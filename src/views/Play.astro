---
import Base from '../layouts/Base.astro'
import SteamCta from '../components/SteamCta.astro'
import SteamHelp from '../components/SteamHelp.astro'
import Icon from '../components/Icon.astro'
import { links } from '../config'
import { href } from '../lib/paths'



type Binding = { action: string; keys: string[] }

const copy = {
    title: 'How to play',
    description: 'Get SLOPArena playtest access on Steam, learn the keyboard and controller controls, and understand damage, stocks, recovery and shields.',
    kicker: 'Field guide',
    lede: 'Get access, learn the buttons, and find out why you just flew off the stage.',
    get: {
      title: 'Get the game',
      steps: [
        { title: 'Request access', text: 'Open SLOPArena on Steam and hit Request Access under “Join the SLOPArena Playtest”. Wishlist it while you’re there.' },
        { title: 'Wait for the email', text: 'The playtest lets people in by waves. Steam emails you when the developer is ready for more players.' },
        { title: 'Install and fight', text: 'SLOPArena Playtest shows up in your Steam library. Install it, open Training, and start hitting things.' },
      ],
      needsTitle: 'What you need',
      needs: ['A Steam account', 'Windows', 'Keyboard and mouse, or a controller (Xbox, DualShock and DualSense work)', 'An internet connection for online rooms'],
    },
    controls: {
      title: 'Controls',
      lede: 'These are the defaults. Remap anything in Settings → Controls, and the HUD always shows your current bindings.',
      keyboard: 'Keyboard and mouse',
      controller: 'Controller',
      kb: [
        { action: 'Move', keys: ['W', 'A', 'S', 'D'] },
        { action: 'Camera', keys: ['Mouse'] },
        { action: 'Jump (tap for a short hop)', keys: ['Space'] },
        { action: 'Shield on the ground, air dodge in the air', keys: ['Shift'] },
        { action: 'Grab', keys: ['C'] },
        { action: 'Crouch, slide, fast fall', keys: ['X'] },
        { action: 'Normals', keys: ['1', '2', '3'] },
        { action: 'Specials, as labelled on the HUD', keys: ['Q', 'E', 'R', 'F'] },
        { action: 'Beeline (homing dash)', keys: ['4'] },
        { action: 'Face where the camera looks', keys: ['Left click'] },
        { action: 'Lock on or off a target', keys: ['Right click'] },
        { action: 'Switch target', keys: ['Tab'] },
        { action: 'Steady or manual camera', keys: ['Y'] },
        { action: 'Zoom', keys: ['Wheel'] },
        { action: 'Pause', keys: ['Esc'] },
      ] as Binding[],
      pad: [
        { action: 'Move', keys: ['Left stick'] },
        { action: 'Jump (tap for a short hop)', keys: ['A'] },
        { action: 'Shield on the ground, air dodge in the air', keys: ['RT'] },
        { action: 'Grab', keys: ['LB'] },
        { action: 'Crouch, slide, fast fall', keys: ['LT'] },
        { action: 'Normals 1 · 2 · 3', keys: ['X', 'Y', 'B'] },
        { action: 'Specials Q · E · R · F: flick the right stick', keys: ['↓', '↑', '←', '→'] },
        { action: 'Beeline (homing dash)', keys: ['RB'] },
        { action: 'Face where the camera looks', keys: ['L3'] },
        { action: 'Lock on or off a target (tap)', keys: ['R3'] },
        { action: 'Steady or manual camera (hold)', keys: ['R3'] },
        { action: 'Switch target', keys: ['D-pad →'] },
        { action: 'Pause', keys: ['Start'] },
      ] as Binding[],
      padNote: 'Xbox labels. On PlayStation: A = Cross, X = Square, Y = Triangle, B = Circle, LB/RB = L1/R1, LT/RT = L2/R2. Prefer the old layout? Settings → Controls → Right Stick: Camera puts the camera back on the right stick, specials on LB + A/X/Y/B and grab on LB + RT.',
    },
    basics: {
      title: 'The basics',
      items: [
        { title: 'Damage is distance', text: 'Every hit adds to your percent. The same punch that tickles at 20% launches you at 120%.', loud: true },
        { title: 'Stocks and blast zones', text: 'Fly past the edge of the stage or fall into the void and you lose a stock. Matches start with three. Last fighter standing wins.' },
        { title: 'Getting back', text: 'You have a double jump, an air dodge and an E special built for recovery. There are no ledge grabs in this playtest: land on the stage or don’t land.' },
        { title: 'Beeline', text: 'Press 4 (RB on a controller) to dash straight at your target. Arrive and you can follow up with anything. Miss and you’re wide open. Shields, hitboxes and projectiles beat it.' },
        { title: 'Shield and air dodge', text: 'Hold Shift on the ground to block from every direction. Letting go leaves you open for a moment. In the air, the same button dodges wherever the stick points, once until you land.' },
        { title: 'Short hop, fast fall', text: 'Tap jump for a short hop, hold it for a full jump. Press X while falling to drop fast.' },
        { title: 'Clash', text: 'Two attacks that connect at the same time bounce off each other: no damage, both back to neutral.' },
      ],
    },
    modes: {
      title: 'Modes',
      items: [
        { title: 'Tutorial', text: 'The Fighter’s License: a rooftop test that walks you through the controls one lesson at a time, using your fighter’s real move names.' },
        { title: 'Training', text: 'The Crash-Test Lab: a CPU dummy, drills and recovery islands, with your moves on the HUD. Press Esc to make the dummy attack, shield or dodge, change its damage, or reset positions.' },
        { menu: 'Local Play', title: 'Brawl', text: 'Knock everyone off. Last fighter standing wins. One to four players on one screen, with CPUs in the empty seats.' },
        { menu: 'Local Play', title: 'Slopball', text: 'Land the ball beyond the net with your attacks. A miss resets your combo. Chase your personal best.' },
        { menu: 'Local Play', title: 'Slop Rally', text: 'Any fighter on any course: a solo time trial, or a couch race against friends for targets and finish points.' },
        { menu: 'Local Play', title: 'Manki Mayhem', text: 'Manki calls the round. Survive it to score. Two to four fighters, with CPUs filling in.' },
        { title: 'Online', text: 'Browse rooms or make one, up to four players. The leader picks the stage, everyone picks a fighter, stock rules, rematch in the same room. Still rough: report every desync.' },
      ],
    },
    faq: {
      title: 'Questions',
      items: [
        { q: 'Is it free?', a: ['Yes. SLOPArena is free to play and the playtest is free. There’s nothing to buy.'] },
        { q: 'Why do I have to request access?', a: ['The playtest is limited so the servers and the one developer can keep up. Steam lets people in by waves and emails you when it’s your turn.'] },
        { q: 'Mac or Linux?', a: ['Not officially. The playtest build is made for Windows.'] },
        { q: 'Is it finished?', a: ['No. Balance is unfinished, online play still has connection problems, and things will break. That’s what the feedback form is for.'] },
        { q: 'Is it made with AI?', a: ['Yes, openly. SLOPArena uses AI coding agents and generated art as production tools, and those workflows are public. Every change is still reviewed and playtested by a human.', 'The name owns it.'] },
        { q: 'Where do I report bugs?', a: ['Use the feedback form, post on Discord, or open an issue on GitHub if you can describe how to make it happen again.'] },
        { q: 'Can I contribute?', a: ['Yes. The game is MIT-licensed on GitHub. Start with the docs, then read the contributing guide in the repository.'] },
      ],
    },
    stuck: { title: 'Stuck?', text: 'Ask on Discord. Someone, possibly the developer, will answer.', feedback: 'Send feedback' },
  }

const keyClass = (key: string) => (key === '+' ? 'label' : 'key')
---
<Base route="play/" title={copy.title} description={copy.description}>
  <section class="page-hero">
    <div class="wrap">
      <p class="kicker">{copy.kicker}</p>
      <h1>{copy.title}</h1>
      <p class="lede">{copy.lede}</p>
    </div>
  </section>

  <section class="section" id="access">
    <div class="wrap">
      <h2 class="h3-title">{copy.get.title}</h2>
      <ol class="steps">
        {copy.get.steps.map((step) => <li><h3>{step.title}</h3><p>{step.text}</p></li>)}
      </ol>
      <div class="split" style="margin-top: clamp(32px, 4vw, 48px); align-items: start">
        <div>
          <SteamCta />
          <SteamHelp />
        </div>
        <div class="verdict">
          <h3>{copy.get.needsTitle}</h3>
          <ul>{copy.get.needs.map((need) => <li>{need}</li>)}</ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="controls">
    <div class="wrap">
      <div class="section-head">
        <h2>{copy.controls.title}</h2>
        <p class="lede">{copy.controls.lede}</p>
      </div>
      <div class="controls">
        {[[copy.controls.keyboard, copy.controls.kb], [copy.controls.controller, copy.controls.pad]].map(([title, bindings]) => (
          <div class="control-table">
            <h3>{title as string}</h3>
            <dl>
              {(bindings as Binding[]).map((binding) => (
                <div>
                  <dt>{binding.action}</dt>
                  <dd>{binding.keys.map((key) => <span class={keyClass(key)}>{key}</span>)}</dd>
                </div>
              ))}
            </dl>
          </div>
        ))}
      </div>
      <p class="fine-print">{copy.controls.padNote}</p>
    </div>
  </section>

  <section class="section" id="basics">
    <div class="wrap">
      <div class="section-head"><h2>{copy.basics.title}</h2></div>
      <ul class="basics">
        {copy.basics.items.map((item) => (
          <li class:list={['basic', item.loud && 'basic--loud']}>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="modes">
    <div class="wrap">
      <div class="section-head"><h2>{copy.modes.title}</h2></div>
      <ul class="modes">
        {copy.modes.items.map((item) => (
          <li>
            {item.menu && <p class="label">{item.menu}</p>}
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="faq">
    <div class="wrap">
      <div class="section-head"><h2>{copy.faq.title}</h2></div>
      <div class="faq">
        {copy.faq.items.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <div>{item.a.map((paragraph) => <p>{paragraph}</p>)}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="section band-orange">
    <div class="wrap callout">
      <h2>{copy.stuck.title}</h2>
      <div>
        <p>{copy.stuck.text}</p>
        <div class="callout__actions">
          <a class="btn btn--ink" href={links.discord} target="_blank" rel="noopener"><Icon name="discord" />Discord ↗</a>
          <a class="btn" href={href('feedback/')}>{copy.stuck.feedback} →</a>
        </div>
      </div>
    </div>
  </section>
</Base>
